  {
    "id": "1793153892120",
    "name": "Tomato Galette",
    "image": "https://hips.hearstapps.com/hmg-prod/images/tomato-galette1-1654194146.jpg?crop=0.673xw:1.00xh;0.167xw,0&resize=1200:*",
    "categories": [
