  {
    "id": "1793153663174",
    "name": "Ritz Mock Apple Pie",
    "image": "https://hips.hearstapps.com/hmg-prod/images/361d80ae-33f9-46b7-9766-172d0d850210.jpg?crop=0.5xw:1xh;center,top&resize=1200:*",
    "categories": [
      "autumn",
      "dessert"
    ],
    "prepTime": "10 min",
    "cookTime": "45 min",
    "ingredients": [
      "2 cups water",
      "2/3 cup (133 g) granulated sugar",
      "2 tsp. cream of tartar",
      "35 Ritz Crackers",
      "1 batch store-bought or homemade pie crust",
      "2 tbsp. fresh lemon juice",
      "2 tsp. ground cinnamon",
      "1 cup crushed Ritz Crackers",
      "2/3 cup (142 g) packed light brown sugar",
      "5 tbsp. unsalted butter, melted, slightly cooled",
      "1/2 tsp. ground cinnamon",
      "Whipped topping, for serving"
    ],
    "instructions": [
      "Arrange a rack in center of oven; preheat to 400ºF. In a large saucepan over medium-high heat, bring water, granulated sugar, and cream of tartar to a boil. Add crackers, then reduce heat to medium-low and bring to a simmer. Cook, stirring occasionally, until crackers are softened and broken down, about 5 minutes.",
      "Line a 9\" pie plate with crust. Fill with cracker mixture. Sprinkle with lemon juice and cinnamon.",
      "In a medium bowl, combine crackers, brown sugar, butter, and cinnamon. Sprinkle over filling.",
      "Bake pie for 10 minutes.",
      "Reduce oven temperature to 350° and cover edges of crust with foil. Continue to bake until filling is set and doesn’t jiggle, 18 to 20 minutes more. Transfer to a wire rack and let cool. Top with whipped topping, as desired."
    ],
    "servings": "6 serving(s)",
    "description": "A nostalgic recipe, this Ritz mock apple pie is a classic recipe you have to try to believe. ",
