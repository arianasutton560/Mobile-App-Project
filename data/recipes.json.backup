  {
    "id": "1793153691126",
    "name": "Chicken Noodle Soup",
    "image": "https://hips.hearstapps.com/hmg-prod/images/chicken-noodle-soup-index-644c2bec1ce0c.jpg?crop=0.502xw:1.00xh;0.277xw,0&resize=1200:*",
    "categories": [
