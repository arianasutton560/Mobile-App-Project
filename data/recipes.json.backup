        "thumbnailUrl": "https://hips.hearstapps.com/vidthumb/570f882a-c1cf-4af7-8938-262a82aecc14/thumb_1080x1920.0000001.jpg?crop="
      }
    ]
  },
  {
    "id": "1793153892302",
    "name": "Crispy Hot Honey Cauliflower Nuggets",
