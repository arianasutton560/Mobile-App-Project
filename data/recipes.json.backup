    "name": "Bunny Cake",
    "image": "https://hips.hearstapps.com/hmg-prod/images/easter-bunny-cake-horizontal-1676571620.jpg?crop=0.502xw:1.00xh;0.250xw,0&resize=1200:*",
    "categories": [
