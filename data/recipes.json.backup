      "3 1/4 cups all-purpose flour",
      "1 tbsp. ground ginger",
      "1 tsp. baking soda",
      "1 tsp. ground cinnamon",
      "1/2 tsp. ground cloves",
      "1/4 tsp. ground nutmeg",
      "1/2 tsp. kosher salt",
      "1 2\" piece fresh ginger, grated (optional)",
      "1 orange, zested (optional)",
