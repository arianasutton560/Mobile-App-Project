      "1/4 cup finely chopped fresh parsley&nbsp;",
      "1 tsp. freshly ground black pepper&nbsp;",
      "1 tsp. garlic powder",
      "1 tsp. onion powder",
      "1/2 tsp. kosher salt&nbsp;",
      "1/2 lb. (80% lean) ground beef&nbsp;",
