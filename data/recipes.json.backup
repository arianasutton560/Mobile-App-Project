      "1/2 cup vegetable oil",
      "3/4 cup packed brown sugar&nbsp;",
      "1 large egg",
      "1 tsp. pure vanilla extract",
      "1/2 orange, zested",
      "3/4 cup buttermilk",
      "1 cup cranberries",
      "1/2 cup roughly chopped walnuts",
      "3/4 cup powdered sugar",
