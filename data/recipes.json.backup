      "Kosher salt",
      "3 tbsp. extra-virgin olive oil, divided",
      "1 large yellow onion, thinly sliced",
      "4 garlic cloves, thinly sliced",
      "1 tbsp. fresh thyme leaves",
      "1/4 tsp. crushed red pepper flakes",
      "4 vine-ripened tomatoes, thinly sliced",
      "Freshly ground black pepper",
      "2 tbsp. thinly sliced or shredded fresh basil, divided, plus whole leaves for serving",
      "2 oz. Parmesan, grated (about 1 cup), divided",
      "1 lemon, zested",
      "1 large ball of burrata (from an 8-oz. container)",
      "1 cup panko breadcrumbs"
    ],
    "instructions": [
