[
  {
    "id": "1793153662896",
    "name": "Lasagnchiladas",
    "image": "https://hips.hearstapps.com/hmg-prod/images/fc6458f3-dd81-477d-a8aa-30d355c8427f.jpg?crop=0.562xw:1xh;0.039xw,0xh&resize=1200:*",
    "categories": [
      "italian",
      "european",
      "dinner",
      "latin-american"
    ],
    "prepTime": "10 min",
    "cookTime": "65 min",
    "ingredients": [
      "1 tbsp. extra-virgin olive oil",
      "1 medium yellow onion, finely chopped",
      "1 medium carrot, peeled, finely chopped",
      "Kosher salt",
      "3 garlic cloves, minced",
      "1 lb. lean ground beef",
      "8 oz. hot Italian sausage, casings removed, crumbled",
      "2 tbsp. taco seasoning",
      "2 tbsp. tomato paste",
      "1/2 cup low-sodium beef broth",
      "2 1/2 cups homemade or store-bought marinara sauce, divided",
      "1 large egg",
      "8 oz. ricotta (about 1 cup)",
      "1 tbsp. chopped fresh basil, plus more for serving",
      "1 tbsp. chopped fresh oregano",
      "2 oz. Parmesan, finely grated (about 1 cup), divided",
      "6 (7\") flour tortillas",
      "4 oz. shredded mozzarella",
      "Cooking spray"
    ],
    "instructions": [
      "Arrange a rack in center of oven; preheat to 375°. In a large skillet over medium heat, heat oil and swirl pan to coat. Add onions and carrots; season with 1/2 tsp. salt. Cook, stirring occasionally, until softened, about 7 minutes. Add garlic and cook, stirring, until fragrant, about 1 minute more. Add beef and sausage and cook, breaking meat into small pieces with a wooden spoon, until no pink remains, about 7 minutes.",
      "Add taco seasoning and tomato paste and cook, stirring, until paste darkens in color, about 2 minutes. Add broth and 2 cups marinara. Bring to a simmer and cook, stirring occasionally, until thickened, 10 to 12 minutes; season with salt.",
      "Meanwhile, in a small bowl, combine egg, ricotta, basil, oregano, and 3/4 cup Parmesan.",
      "Spread remaining 1/2 cup marinara in the bottom of a 13\" x 9\" baking dish. Place a tortilla on a work surface or large plate next to dish. Spoon 1/2 cup meat sauce in center of tortilla. Top with a scant 1/4 cup ricotta mixture. Roll tortilla to close and transfer to baking dish. Repeat with remaining tortillas. Top tortillas with remaining meat sauce. Sprinkle with mozzarella and remaining 1/4 cup Parmesan. Spray a sheet of foil with cooking spray and cover baking dish with foil greased side down.",
      "Bake lasagnchiladas until warmed through and cheese is melted, about 25 minutes. Uncover and move a rack to position closest to broiler. Turn on broiler.",
      "Broil, watching closely, until cheese is bubbling and brown, 2 to 3 minutes. Top with more basil."
    ],
    "servings": "6 - 8 serving(s)",
    "description": "In this lasagna and enchilada mash-up, bolognese and ricotta are rolled into flour tortillas, then topped with more cheese before being baked until perfection. ",
    "videos": [
      {
        "url": "https://mos-streaming.hearst.io/4694e13b-fe39-47da-8dc0-e196ed1454fe/video_9x16_1080p_h264_hd.mp4",
        "title": "Lasagnchiladas",
        "thumbnailUrl": "https://hips.hearstapps.com/vidthumb/4694e13b-fe39-47da-8dc0-e196ed1454fe/thumb_1080x1920.0000001.jpg?crop="
      }
    ]
  },
  {
    "id": "1793153662984",
    "name": "Pumpkin Parmesan Pinwheels",
    "image": "https://hips.hearstapps.com/hmg-prod/images/41af2a5c-b5b9-4740-ac56-bf9d30825fd8.jpg?crop=0.5xw:1xh;0.391xw,0xh&resize=1200:*",
    "categories": [
      "italian",
      "european",
      "autumn"
    ],
    "prepTime": "15 min",
    "cookTime": "60 min",
    "ingredients": [
      "1 cup pumpkin puree (such as Libby’s)",
      "2 garlic cloves, minced",
      "1 oz. Parmesan, finely grated (about 1/2 cup)",
      "2 tsp. finely chopped fresh sage",
      "1/2 tsp. kosher salt",
      "1/4 tsp. freshly ground black pepper",
      "All-purpose flour, for dusting",
      "1 (14-oz.) pkg. frozen puff pastry, thawed",
      "1 large egg, lightly beaten"
    ],
    "instructions": [
      "Spread pumpkin puree on a paper towel-lined plate, then pat dry with a clean kitchen towel or paper towels to remove excess moisture.",
      "Transfer pumpkin puree to a large bowl. Add garlic, Parmesan, sage, salt, and pepper and stir to combine.",
      "On a lightly floured surface, unfold puff pastry, then roll to a 15\" x 11\" rectangle. Spread pumpkin mixture over puff pastry, leaving a 1/2\" border on one long side. Starting with a long side, roll up pastry into a log, then pinch seam to seal. Transfer roll, seam side down, to a parchment-lined baking sheet. Freeze until chilled, about 40 minutes.",
      "Arrange racks in upper and lower thirds of oven; preheat to 400°. Transfer roll to a cutting board. Trim 1/2\" from each end, then cut roll into 1/2\"-thick slices. Arrange on 2 parchment-lined baking sheets. Using your fingers, pat pinwheels into a round shape if cutting has made them lopsided. Brush pinwheels with egg wash.",
      "Bake pinwheels, rotating sheets front to back and top to bottom halfway through, until pastry is golden brown and crisp, 15 to 20 minutes. Transfer pinwheels to a wire rack and let cool."
    ],
    "servings": "28 serving(s)",
    "description": "Our pumpkin Parmesan pinwheels strike the perfect balance of sweet, savory, and decadent."
  },
  {
    "id": "1793153663078",
    "name": "Tofu Burritos",
    "image": "https://hips.hearstapps.com/hmg-prod/images/tofu-burritos-index-67bca06ab02b8.jpg?crop=0.503xw:1.00xh;0.277xw,0&resize=1200:*",
    "categories": [
