      "1 1/4 cups (250 g.) granulated sugar, divided",
      "1 tsp. pure vanilla extract",
      "5 large egg whites",
      "1/2 cup whole milk",
      "4 tbsp. unsalted butter, melted, cooled",
      "1 (14-oz.) can sweetened condensed milk",
      "1 (12-oz.) can evaporated milk",
