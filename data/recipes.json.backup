    "id": "1793153723226",
    "name": "Harvest Caesar Salad",
    "image": "https://hips.hearstapps.com/hmg-prod/images/del109924-harvest-caesar-salad-web-967-jg-index-6712896a7bbcf.jpg?crop=0.502xw:1.00xh;0.0625xw,0&resize=1200:*",
    "categories": [
