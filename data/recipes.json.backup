      "1 tsp. pumpkin pie spice",
      "1/2 tsp. kosher salt",
      "3 (8 oz)&nbsp;pkgs. cream cheese, softened",
      "3/4 cup granulated sugar",
      "1/2 cup sour cream",
      "1 tsp. pure vanilla extract",
